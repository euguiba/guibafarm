{
  "name": "navegador-idle",
  "version": "0.3.0",
  "private": true,
  "description": "Navegador desktop para jogos idle: perfis isolados por conta, analisador por jogo, assistente e lucro por hora.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "productName": "Navegador Idle",
  "author": "Guilherme Freire de Siqueira",
  "build": {
    "appId": "com.navegadoridle.app",
    "productName": "Navegador Idle",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.test.js",
      "!dist/**/*.map",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Navegador Idle",
      "runAfterFinish": true,
      "artifactName": "Navegador-Idle-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "euguiba",
        "repo": "navegador-idle",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/euguiba/navegador-idle.git"
  }
}
