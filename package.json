{
  "name": "navegador-idle",
  "version": "0.1.0",
  "private": true,
  "description": "Navegador desktop para jogos idle: perfis isolados por conta, analisador por jogo, assistente e lucro por hora.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.7.0",
    "typescript": "^5.9.3"
  }
}
